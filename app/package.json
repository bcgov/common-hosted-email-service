{
  "name": "common-hosted-email-service",
  "version": "1.0.0",
  "private": true,
  "description": "CHES - Powered by NodeMailer (a shared library)",
  "author": "NR Common Service Showcase <NR.CommonServiceShowcase@gov.bc.ca>",
  "scripts": {
    "build": "echo Nothing to build",
    "clean": "rm -rf coverage dist",
    "lint:fix": "eslint . --fix",
    "lint": "eslint . --no-fix",
    "migrate:down": "knex migrate:down",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:up": "knex migrate:up",
    "migrate": "npm run migrate:latest",
    "postrebuild": "npm run build",
    "postreinstall": "npm install",
    "posttest": "node ./lcov-fix.js",
    "pretest": "npm run lint",
    "purge": "rm -rf ./node_modules",
    "rebuild": "npm run clean",
    "reinstall": "npm run purge",
    "serve": "nodemon ./bin/www",
    "start": "node ./bin/www",
    "test:all": "jest --verbose --forceExit --detectOpenHandles",
    "test:integration": "jest --verbose --testPathIgnorePatterns unit --collectCoverage false --forceExit --detectOpenHandles",
    "test:unit": "jest --verbose --testPathIgnorePatterns integration --forceExit --detectOpenHandles",
    "test": "npm run test:unit"
  },
  "homepage": "https://github.com/bcgov/common-hosted-email-service",
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "api-problem": "^9.0.2",
    "bull": "^4.16.5",
    "bytes": "^3.1.2",
    "compression": "^1.8.2",
    "config": "^5.0.1",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-winston": "^4.2.0",
    "globals": "^17.14.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "moment": "^2.31.0",
    "nodemailer": "^10.6.0",
    "nunjucks": "^3.2.4",
    "objection": "^4.4.3",
    "pg": "^8.23.1",
    "tmp": "^0.2.7",
    "validator": "^13.15.35",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "babel-plugin-transform-import-meta": "^3.1.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "jest": {
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "\\.m?js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(config|objection)/)"
    ],
    "testMatch": [
      "**/tests/**/*.spec.(js|jsx|ts|tsx)|**/__tests__/*.(js|jsx|ts|tsx)"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/docs/*.*",
      "!src/middleware/*.*",
      "!src/services/*.*",
      "!src/services/migrations/*.*",
      "!src/services/models/*.*"
    ]
  },
  "license": "Apache-2.0",
  "nodemonConfig": {
    "ignore": [
      "node_modules/**/node_modules",
      "test"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcgov/common-hosted-email-service.git"
  },
  "bugs": {
    "url": "https://github.com/bcgov/common-hosted-email-service/issues"
  }
}
